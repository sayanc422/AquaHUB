<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aquashop</groupId>
  <artifactId>staff-portal</artifactId>
  <version>0.1.0</version>
  <packaging>war</packaging>

  <!--
    Plain Servlets + JSP, no Spring. This is deliberate, not an oversight: this
    service exists to be the WAR-on-WildFly exercise (see docs/architecture.md
    Phase 6 notes), and a Spring Boot fat jar would defeat the point. Maven is
    already this project's Java build tool: see docs/context_summary.md's
    "matches the WildFly/WAR world" line, so nothing here is a second
    unfamiliar toolchain.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <failOnMissingWebXml>false</failOnMissingWebXml>
  </properties>

  <dependencies>
    <!-- Provided by WildFly at runtime; not packaged in the WAR. -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <version>10.0.0</version>
      <scope>provided</scope>
    </dependency>

    <!--
      Packaged into WEB-INF/lib: WildFly does not bundle a JSON library by
      default for plain servlets (only for JAX-RS/RESTEasy, which this service
      does not use), and hand-rolling JSON parsing for three backend APIs is
      the wrong kind of "no framework" purity.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>staff-portal</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
